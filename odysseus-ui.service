# Copy to /etc/systemd/system/odysseus-ui.service
# Edit User, WorkingDirectory, and ExecStart paths to match your setup
[Unit]
Description=Odysseus UI
After=network.target

[Service]
Type=simple
# CHANGE THESE to match your user and install path:
User=YOURUSER
WorkingDirectory=/home/YOURUSER/odysseus-ui
# Binds to localhost only — a personal AI workspace should NOT be exposed to
# the whole network by default. To deliberately reach it from other devices,
# change --host to 0.0.0.0 AND put it behind a reverse proxy / Tailscale with
# auth, never raw on a LAN.
ExecStart=/home/YOURUSER/odysseus-ui/venv/bin/uvicorn app:app --port 7000 --host 127.0.0.1
Restart=always
RestartSec=3
EnvironmentFile=-/home/YOURUSER/odysseus-ui/.env

[Install]
WantedBy=multi-user.target
